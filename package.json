{
  "name": "airbnb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "yarn --cwd frontend dev",
    "dev:frontend": "yarn --cwd frontend dev",
    "dev:backend": "cd backend && uvicorn main:app --host 127.0.0.1 --port 8001 --reload",
    "dev:all": "concurrently -n backend,frontend -c cyan,magenta \"yarn dev:backend\" \"yarn --cwd frontend dev\"",
    "build": "yarn --cwd frontend build",
    "start": "yarn --cwd frontend start",
    "install:frontend": "yarn --cwd frontend install"
  },
  "devDependencies": {
    "concurrently": "9.1.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
