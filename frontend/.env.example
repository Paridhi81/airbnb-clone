# Copy this file to .env before starting the app.
# The Next.js dev server reads FASTAPI_URL and proxies every /api/*
# request to the FastAPI backend. It MUST match the port uvicorn is
# listening on (see backend/.env.example).

NEXT_PUBLIC_BASE_URL=http://localhost:3000
FASTAPI_URL=http://127.0.0.1:8001
CORS_ORIGINS=http://localhost:3000
